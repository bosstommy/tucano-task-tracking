{
  "name": "tucano",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TUCANO — agenda personale delle attività",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && cross-env NODE_ENV=production tsx server/index.ts",
    "serve": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx server/seed.ts",
    "seed:test": "cross-env TUCANO_DATA=.testdata tsx server/seed.ts",
    "dev:test": "cross-env TUCANO_PORT=3002 TUCANO_DATA=.testdata npm run dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}